{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "decomposition.schema.json",
  "title": "Decomposition (reverse analysis of ONE ad — competitor benchmark or internal QC)",
  "description": "DECOMPOSITION d'UNE ad (reverse). Vit a brands/{slug}/competitive-intel/{batch}/{RCV-NN}/decomposition.json (benchmark concurrent) OU sert le QC interne. Miroir reverse du genome-package (forward). audio+edit optionnels (support-agnostic).",
  "type": "object",
  "version": "1.3.0",
  "required": [
    "meta",
    "identification",
    "script",
    "visual",
    "analysis_meta"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "description": "Schema metadata · versioning + traceability",
      "required": [
        "schema_version",
        "analysis_date"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "enum": ["1.0.0", "1.1.0", "1.2.0", "1.3.0"]
        },
        "analysis_date": {
          "type": "string",
          "format": "date-time"
        },
        "analyst": {
          "type": "string",
          "description": "Claude session id OR human analyst name"
        },
        "session_id": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "identification": {
      "type": "object",
      "description": "Video identification · file + source + targeting metadata",
      "required": [
        "video_id",
        "brand_slug",
        "support",
        "video_meta"
      ],
      "additionalProperties": false,
      "properties": {
        "video_id": {
          "type": "string",
          "description": "Unique id · prefer Meta ad_id if known · else filename"
        },
        "support": {
          "type": "string",
          "enum": [
            "video",
            "static",
            "carousel-card",
            "carousel-set",
            "gif-animated",
            "cinemagraph",
            "other"
          ],
          "description": "Type de support de l'ad. Conditionne quels blocs s'appliquent · un statique n'a ni audio, ni edit, ni timeline (body_arc encode l'ordre de lecture via beat_id, start_s/end_s omis)."
        },
        "video_file_path": {
          "type": "string"
        },
        "brand_slug": {
          "type": "string",
          "description": "PhantomOS brand workspace slug · ex 'glp1sos' · 'stepprs'"
        },
        "advertiser_id_fb": {
          "type": "string",
          "description": "Facebook Page ID"
        },
        "source_platform": {
          "type": "string",
          "enum": [
            "meta-ads-library",
            "tiktok-creative-center",
            "trendtrack-export",
            "manual-upload",
            "youtube-ads",
            "other"
          ]
        },
        "url_meta_ad_library": {
          "type": "string",
          "format": "uri"
        },
        "countries_targeted": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "ISO 3166-1 alpha-2"
          }
        },
        "placement_inferred": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "reels",
              "stories",
              "feed",
              "audience-network",
              "marketplace",
              "search",
              "in-stream",
              "tiktok-feed",
              "tiktok-spark",
              "other"
            ]
          }
        },
        "video_meta": {
          "type": "object",
          "required": [
            "aspect_ratio"
          ],
          "additionalProperties": false,
          "properties": {
            "duration_s": {
              "type": "number",
              "minimum": 0
            },
            "width_px": {
              "type": "integer"
            },
            "height_px": {
              "type": "integer"
            },
            "aspect_ratio": {
              "type": "string",
              "enum": [
                "9:16",
                "1:1",
                "4:5",
                "16:9",
                "4:3",
                "2:3",
                "3:4",
                "custom"
              ]
            },
            "fps": {
              "type": "number"
            },
            "file_size_kb": {
              "type": "integer"
            }
          }
        },
        "timeline_external": {
          "type": "object",
          "description": "Meta Ad Library lifecycle data if available · optional",
          "additionalProperties": false,
          "properties": {
            "date_first_seen": {
              "type": "string",
              "format": "date"
            },
            "date_last_seen": {
              "type": "string",
              "format": "date"
            },
            "days_active_current": {
              "type": "integer"
            }
          }
        }
      }
    },
    "script": {
      "type": "object",
      "description": "Narrative structure · transcript + hook + body arc + cta · SCRIPT scope (D#2026-05-25 SCRIPT vs PRODUCTION split)",
      "required": [
        "transcript_full",
        "language",
        "hook"
      ],
      "additionalProperties": false,
      "properties": {
        "transcript_full": {
          "type": "string"
        },
        "transcript_source": {
          "type": "string",
          "enum": [
            "groq-whisper-large-v3-turbo",
            "groq-whisper-large-v3",
            "openai-whisper",
            "manual-transcription",
            "meta-captions-extracted",
            "other"
          ]
        },
        "language": {
          "type": "string",
          "description": "BCP-47 · 'en', 'es', 'fr', etc."
        },
        "script_word_count": {
          "type": "integer"
        },
        "script_words_per_second": {
          "type": "number"
        },
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "start_s",
              "end_s",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "start_s": {
                "type": "number"
              },
              "end_s": {
                "type": "number"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "hook": {
          "type": "object",
          "required": [
            "mechanic_id",
            "hook_text_first_15_words"
          ],
          "additionalProperties": false,
          "properties": {
            "mechanic_id": {
              "type": "string",
              "description": "Référence à hook-mechanics-registry (NEW canon) · ~25-40 mécaniques canonisées · à raffiner cross-N",
              "enum": [
                "paradox-testimonial",
                "confrontation-rhetorical",
                "listicle-curiosity",
                "false-solution-debunking",
                "authority-demolition",
                "mechanism-reveal",
                "resolution-promise",
                "social-relational-pain",
                "hidden-secret-framing",
                "doctor-dialogue",
                "taboo-signal",
                "visceral-specific-testimony",
                "negative-command",
                "pov-illustrated-humor",
                "allegory-romance",
                "macro-graphic-icons",
                "before-after-timeline",
                "pricing-anchor",
                "testimonial-paradox-numeric",
                "scientific-claim-reveal",
                "competitor-comparison-explicit",
                "category-of-one-claim",
                "if-then-conditional-hook",
                "rhetorical-shock-question",
                "other-uncategorized"
              ]
            },
            "hook_text_first_15_words": {
              "type": "string"
            },
            "hook_text_first_3s": {
              "type": "string"
            },
            "hook_skeleton_inferred": {
              "type": "string",
              "description": "Skeleton paramétrique inféré · ex '[positive_outcome] on my [object], but [negative_paradox]'"
            },
            "hook_atlas_slots": {
              "type": "object",
              "description": "Slots remplis depuis atlas brand · ex { positive_outcome: 'Down 20 lbs', object: 'GLP-1', paradox: 'bloated like pregnant' }",
              "additionalProperties": {
                "type": "string"
              }
            },
            "hook_overlay_color_accent": {
              "type": "string",
              "description": "Couleur d'accent overlay hook · ex 'dark-green', 'red', 'white-default'"
            },
            "hook_visual_style_first_shot": {
              "type": "string",
              "description": "Reference vers visual.styles_observed[].style_id"
            },
            "hook_emoji_present": {
              "type": "boolean"
            }
          }
        },
        "body_arc": {
          "type": "array",
          "description": "Decomposition narrative en beats canoniques · plus le découpage est fin, plus l'extraction pattern est précise. start_s/end_s OPTIONNELS (vidéo) · un statique encode l'ordre via beat_id sans timestamps.",
          "items": {
            "type": "object",
            "required": [
              "beat_id",
              "beat_type"
            ],
            "additionalProperties": false,
            "properties": {
              "beat_id": {
                "type": "integer"
              },
              "start_s": {
                "type": "number"
              },
              "end_s": {
                "type": "number"
              },
              "duration_s": {
                "type": "number"
              },
              "beat_type": {
                "type": "string",
                "enum": [
                  "hook",
                  "pain-litany",
                  "pain-amplification",
                  "authority-demolition",
                  "false-solution-rebuttal",
                  "mechanism-reveal",
                  "solution-direction",
                  "ingredients-pillars",
                  "competitor-comparison",
                  "product-reveal",
                  "product-specs",
                  "resolution-timeline",
                  "benefit-lifestyle",
                  "social-proof",
                  "scientific-claim",
                  "guarantee-statement",
                  "cta",
                  "disclaimer",
                  "transition",
                  "loop-callback"
                ]
              },
              "narrative_purpose": {
                "type": "string"
              },
              "key_phrases": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "linked_atlas_pain_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "linked_atlas_mechanism_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "linked_atlas_objection_ids": {
                "type": "array",
                "description": "OBJ-NN canoniques adresses par ce beat (D#492). A renseigner surtout quand beat_type = 'false-solution-rebuttal' (ou authority-demolition / competitor-comparison) = le grain ou l'objection apparait REELLEMENT dans la pub. Symetrique de linked_atlas_pain_ids. L'objection n'est PAS un axe de la pub entiere (pas systematique) : elle vit au beat qui la traite, et globalement dans l'angle (lineage.objection_ref).",
                "items": {
                  "type": "string"
                }
              },
              "linked_atlas_ingredient_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "linked_atlas_competitor_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "visual_style_during": {
                "type": "string",
                "description": "Reference vers visual.styles_observed[].style_id"
              }
            }
          }
        },
        "cta": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start_s": {
              "type": "number"
            },
            "end_s": {
              "type": "number"
            },
            "duration_s": {
              "type": "number"
            },
            "format_type": {
              "type": "string",
              "enum": [
                "brand-end-card",
                "pack-shot-cta",
                "text-overlay-only",
                "multi-element-stack",
                "domain-only-card",
                "tagline-bottle-domain",
                "tagline-bottle-mbg-seal",
                "other"
              ]
            },
            "copy_keywords": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "urgency_elements": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "ex 'TODAY ONLY', 'ENDS MIDNIGHT'"
            },
            "mbg_seal_present": {
              "type": "boolean"
            },
            "domain_visible": {
              "type": "string",
              "description": "Le domain s'il est visible · empty string sinon"
            },
            "pricing_visible": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "primary": {
                  "type": "string"
                },
                "strike_through": {
                  "type": "string"
                },
                "discount_pct": {
                  "type": "number"
                }
              }
            }
          }
        },
        "proprietary_vocabulary": {
          "type": "array",
          "description": "Termes brand-specific · ex 'GLP-1 Fog', 'Clockwork Mornings', 'Sulphur Burps Defense'",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "term": {
                "type": "string"
              },
              "role": {
                "type": "string",
                "enum": [
                  "pain-anchor",
                  "ingredient",
                  "competitor-name",
                  "brand-name",
                  "benefit-name",
                  "mechanism-concept",
                  "audience-self-label",
                  "other"
                ]
              },
              "frequency": {
                "type": "integer"
              }
            }
          }
        },
        "compliance_disclaimers_visible": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "fda-dramatization",
              "fda-not-evaluated",
              "not-affiliated-brand",
              "individual-results-vary",
              "medical-disclaimer",
              "age-restriction",
              "consult-doctor",
              "other"
            ]
          }
        }
      }
    },
    "visual": {
      "type": "object",
      "description": "Production observable · styles + character + anatomy + pack shot + end card + text overlays · PRODUCTION scope",
      "required": [
        "styles_observed",
        "character_pattern"
      ],
      "additionalProperties": false,
      "properties": {
        "format_orientation": {
          "type": "string",
          "enum": [
            "vertical-9-16",
            "square-1-1",
            "vertical-4-5",
            "horizontal-16-9",
            "vertical-2-3",
            "horizontal-3-4",
            "other"
          ]
        },
        "styles_observed": {
          "type": "array",
          "description": "Inventaire des styles visuels distincts utilisés dans cette vidéo. Une vidéo factory mix typiquement 3-4 styles.",
          "items": {
            "type": "object",
            "required": [
              "style_id"
            ],
            "additionalProperties": false,
            "properties": {
              "style_id": {
                "type": "string",
                "enum": [
                  "real-photo-lifestyle",
                  "real-photo-testimonial-static",
                  "real-photo-product-studio",
                  "real-photo-macro-detail",
                  "ugc-selfie-talking",
                  "claymation-3d-ai",
                  "illustrated-pov-cartoon",
                  "3d-anatomy-realistic",
                  "3d-anatomy-stylized",
                  "3d-anatomy-xray",
                  "stock-footage-broll",
                  "pack-shot-brand-template",
                  "brand-motion-graphic",
                  "macro-photo-mouth-skin-etc",
                  "graphic-icons-overlay",
                  "split-screen-comparison",
                  "screen-recording-mockup",
                  "diagram-medical-2d",
                  "stop-motion-physical",
                  "ai-generated-realistic-photo",
                  "ai-generated-stylized",
                  "other"
                ]
              },
              "palette_description": {
                "type": "string",
                "description": "Texture / couleurs / mood · ex 'warm-organic-orange', 'cold-blue-clinical'"
              },
              "beats_associated": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              },
              "approx_shot_count": {
                "type": "integer"
              },
              "evidence_frame_paths": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "character_pattern": {
          "type": "object",
          "required": [
            "character_archetype"
          ],
          "additionalProperties": false,
          "properties": {
            "character_archetype": {
              "type": "string",
              "description": "Pattern d'archétype révélé N=3 · stratégie identification audience",
              "enum": [
                "single-character-multi-settings",
                "single-couple-multi-settings",
                "multi-characters-parallel",
                "no-character-anatomy-only",
                "talking-head-single",
                "talking-head-multi",
                "animated-non-human-character",
                "narrator-author-only-voice",
                "dialogue-chat-screenshot",
                "split-before-after",
                "other"
              ]
            },
            "character_age_target_inferred": {
              "type": "string",
              "enum": [
                "young-20-30",
                "adult-30-40",
                "mid-life-40-50",
                "senior-50-65",
                "senior-65plus",
                "multi-age",
                "ambiguous"
              ]
            },
            "character_gender_visible": {
              "type": "string",
              "enum": [
                "female",
                "male",
                "mixed",
                "none-visible",
                "animated-ambiguous"
              ]
            },
            "character_consistency_across_shots": {
              "type": "string",
              "enum": [
                "strict-same-person",
                "costume-consistent-different-shots",
                "same-archetype-different-actors",
                "varied-multi-persona",
                "n-a"
              ]
            },
            "talking_head_present": {
              "type": "boolean"
            },
            "lipsync_present": {
              "type": "boolean"
            },
            "voiceover_present": {
              "type": "boolean"
            }
          }
        },
        "anatomy_3d": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "present": {
              "type": "boolean"
            },
            "placement_beats": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "description": "beat_ids où anatomy 3D apparaît"
            },
            "palette": {
              "type": "string",
              "enum": [
                "organic-orange",
                "stop-motion-claymation",
                "blue-xray-transparent",
                "medical-white-clean",
                "stylized-cartoon",
                "other"
              ]
            },
            "shot_count": {
              "type": "integer"
            },
            "duration_total_s": {
              "type": "number"
            },
            "style_class": {
              "type": "string",
              "enum": [
                "realistic-medical",
                "stylized-friendly",
                "claymation-physical",
                "2d-illustrated",
                "ai-generated",
                "other"
              ]
            }
          }
        },
        "pack_shot": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "present": {
              "type": "boolean"
            },
            "reuse_id": {
              "type": "string",
              "description": "Identifier cross-vidéo · si setup identique observé dans autre vidéo · null sinon"
            },
            "style_class": {
              "type": "string",
              "enum": [
                "photo-studio-real-clean",
                "photo-studio-real-context",
                "animated-3d-rotation",
                "brand-illustrated",
                "in-context-scene",
                "macro-product-detail",
                "other"
              ]
            },
            "shot_count": {
              "type": "integer"
            },
            "bottle_visible": {
              "type": "boolean"
            },
            "capsules_visible": {
              "type": "boolean"
            }
          }
        },
        "end_card": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "present": {
              "type": "boolean"
            },
            "variant_id": {
              "type": "string",
              "description": "Identifier de template end card · ex 'brand-template-tagline-A', 'mbg-seal-variant-B'"
            },
            "tagline_text": {
              "type": "string"
            },
            "domain_visible": {
              "type": "string"
            },
            "mbg_seal_present": {
              "type": "boolean"
            },
            "logo_visible": {
              "type": "boolean"
            },
            "duration_s": {
              "type": "number"
            },
            "ai_indicators_present": {
              "type": "boolean",
              "description": "ex text rendering anomalies, label flou, etc. · flag pour signal stack production"
            }
          }
        },
        "text_overlays": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "style_class": {
              "type": "string",
              "enum": [
                "pills-bottom",
                "captions-bottom-narrow",
                "kinetic-typography",
                "static-text-corners",
                "meme-style-top-bottom",
                "varying-styles",
                "no-overlays"
              ]
            },
            "position_dominant": {
              "type": "string",
              "enum": [
                "center-bottom",
                "center-top",
                "center-middle",
                "varying"
              ]
            },
            "font_family_observed": {
              "type": "string"
            },
            "accent_color_count": {
              "type": "integer"
            },
            "sync_to_voice": {
              "type": "boolean"
            },
            "avg_words_per_overlay": {
              "type": "number"
            },
            "avg_overlay_duration_s": {
              "type": "number"
            },
            "auto_caption_tool_inferred": {
              "type": "string",
              "enum": [
                "captions-ai",
                "submagic",
                "opus-clip",
                "veed",
                "kapwing",
                "manual",
                "unknown"
              ]
            }
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "description": "Voice + music + audio stack",
      "additionalProperties": false,
      "properties": {
        "voice_modality_dominant": {
          "type": "string",
          "enum": [
            "voiceover-only",
            "talking-head-only",
            "mixed-voiceover-and-talking",
            "text-only-no-voice"
          ]
        },
        "music_present": {
          "type": "boolean"
        },
        "music_genre_inferred": {
          "type": "string",
          "enum": [
            "low-key-emotional",
            "upbeat-pop",
            "clinical-corporate",
            "dramatic-cinematic",
            "ambient",
            "tension-suspense",
            "documentary-warm",
            "none",
            "other"
          ]
        },
        "music_provider_hypothesis": {
          "type": "string",
          "enum": [
            "epidemic-sound",
            "artlist",
            "musicbed",
            "soundstripe",
            "uppbeat",
            "youtube-library",
            "unknown"
          ]
        },
        "voice_gender": {
          "type": "string",
          "enum": [
            "female",
            "male",
            "mixed-multi",
            "none"
          ]
        },
        "voice_age_inferred": {
          "type": "string",
          "enum": [
            "young",
            "adult",
            "mature",
            "senior",
            "varied"
          ]
        },
        "voice_accent": {
          "type": "string",
          "enum": [
            "american-neutral",
            "american-southern",
            "british-rp",
            "australian",
            "french",
            "spanish",
            "european-neutral",
            "other",
            "unidentified"
          ]
        },
        "voice_emotional_tone": {
          "type": "string",
          "enum": [
            "neutral-narrative",
            "empathic-caring",
            "authoritative-confident",
            "confessional-vulnerable",
            "enthusiastic-excited",
            "clinical-detached",
            "conversational-friendly",
            "other"
          ]
        },
